{
  "name": "@huloglobal/vendure-plugin-geo-block",
  "version": "0.15.0",
  "description": "Per-channel geo-restriction for Vendure storefronts: allow or block by country, region preset, state or province, with server-side purchase enforcement, IPv4/IPv6 allowlist, business hours, per-channel maintenance windows, local MaxMind fallback, verified search-bot allowlist, soft-block mode and a branded block page.",
  "license": "AGPL-3.0-only",
  "author": "Wayne Garrison <wayne@garrison.me.uk>",
  "homepage": "https://huloglobal.com/vendure-plugins/geo-block/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huloglobal/vendure-plugin-geo-block.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "ui",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "logo.svg",
    "hulo-global-logo.svg",
    "hulo-global-logo-light.svg",
    "hulo-global-logo-dark.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "graphql-tag": "^2.12.7",
    "@huloglobal/vendure-licence-sdk": "^0.15.6"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@vendure/core": ">=3.5.0 <4.0.0",
    "typeorm": ">=0.3.0",
    "nodemailer": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huloglobal/vendure-licence-sdk": "^0.15.6",
    "@nestjs/common": "^12.0.1",
    "@vendure/core": "3.8.2",
    "nodemailer": "^6.9.0",
    "typeorm": "^0.3.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "geo-block",
